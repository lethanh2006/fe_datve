# Địa chỉ API. Để trống khi dev: Vite proxy /api sang BACKEND_URL (xem vite.config.ts).
# Khi deploy tách domain, đặt thành URL của backend, ví dụ https://api.example.com
VITE_API_BASE_URL=

# Múi giờ hiển thị giờ diễn
VITE_TIME_ZONE=Asia/Ho_Chi_Minh

# Chỉ dùng cho dev server: backend để proxy tới
BACKEND_URL=http://localhost:8080
